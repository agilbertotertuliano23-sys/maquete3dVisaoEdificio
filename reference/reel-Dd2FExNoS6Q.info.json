{"id": "Dd2FExNoS6Q", "title": "Video by ilusaodigital", "description": "A Fachada Interativa transforma o empreendimento em uma ferramenta de informação: torres, unidades, plantas, status, localização, etc...\n\nJá o Tour 360 traz o cliente para dentro do projeto, com uma experiência muito mais imersiva, realista e envolvente.\n\nOs dois conectados na mesma plataforma, formam uma combinação poderosa para vendas.\n\nTecnologia, informação e experiência trabalhando juntas para apresentar melhor cada empreendimento.\n\nFale conosco no direct e vamos juntos viabilizar esta ferramenta para o seu lançamento!\n\n#arquitetura #construcaocivil #lancamentoimobiliário #realstate #experience", "channel": "ilusaodigital", "uploader_id": "4634082256", "uploader": "Ilusão Digital®", "timestamp": 1790629139, "like_count": 17, "comment_count": 0, "http_headers": {"Referer": "https://www.instagram.com/"}, "formats": [{"format_id": "dash-1073320478668307a", "ext": "m4a", "tbr": 57.392, "asr": 44100, "format_note": "DASH audio", "container": "m4a_dash", "vcodec": "none", "acodec": "mp4a.40.5", "url": "https://scontent-for2-1.cdninstagram.com/o1/v/t2/f2/m78/AQMrBZDK8uEAccrILzXje7oj3BZGJ7T9Bu6LwhxEf-EQAp_pWDa45ldavs84jFlBhgEqwVxFknXt7zTdSmxKk0xzIiicbGenJyzv7Vc.mp4?_nc_cat=106&_nc_sid=9ca052&_nc_ht=scontent-for2-1.cdninstagram.com&_nc_ohc=MLrG62DGSdoQ7kNvwF4p5vO&%3D%3D&ccb=17-1&_nc_gid=-9rvdvKr3ddK5lHOpIYF3g&_nc_ss=70689&_nc_map=urlgen_bucketless&_nc_zt=28&oh=00_AQQiI3u-9DUzHfpZvEBui-Qg170FTN-ZjOivoHAWXCtwzA&oe=6AFBE78F", "manifest_stream_number": 0, "is_dash_periods": true, "protocol": "https", "audio_ext": "m4a", "video_ext": "none", "vbr": 0, "abr": 57.392, "resolution": "audio only", "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "htt